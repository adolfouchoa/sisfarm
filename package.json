{
  "name": "sisfarm",
  "version": "1.0.0",
  "description": "Sistema de Gerenciamento de Fazenda de Plantações - Farm Management System",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "cd server && npm run dev",
    "client:dev": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "npm install && cd server && npm install && cd ../client && npm install"
  },
  "keywords": [
    "agriculture",
    "farm",
    "plantation",
    "management",
    "crops",
    "embrapa",
    "ai",
    "dashboard"
  ],
  "author": "SisFarm Team",
  "license": "Apache-2.0",
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "workspaces": [
    "server",
    "client"
  ]
}