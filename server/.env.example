# Server Environment Variables
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://localhost:27017/sisfarm

# JWT
JWT_SECRET=sisfarm_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# EMBRAPA API Integration
EMBRAPA_API_URL=https://api.embrapa.br
EMBRAPA_API_KEY=your_embrapa_api_key_here

# File Upload
MAX_FILE_SIZE=10MB
UPLOAD_PATH=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001